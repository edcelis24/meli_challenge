{
    "default": {
        "paths": ["src/test/features/"],
        "formatOptions": {
            "snippetInterface": "async-await"
        },
        "require": [
            "src/test/steps/*.ts",
            "src/hooks/hooks.ts"
        ],
        "requireModule": ["ts-node/register"],
        "format": [
            "progress-bar",
            "html:test-results/cucumber-report.html"
        ],
        "retry": 0,
        "dryRun": false
    }
}